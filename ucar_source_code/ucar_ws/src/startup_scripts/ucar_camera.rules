# Stable camera alias for the RHX USB Camera (0edc:2050).
# The kernel video index may change after USB re-enumeration; this alias does not.
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", ATTRS{idVendor}=="0edc", ATTRS{idProduct}=="2050", ATTRS{serial}=="20190827", SYMLINK+="ucar_camera", GROUP="video", MODE="0660"
