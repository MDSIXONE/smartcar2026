<launch>
    <param name="use_sim_time" value="true"/>

    <!--起始点-->
    <arg name="initial_pose_x" default="-0.2"/>
	<arg name="initial_pose_y" default="-0.15"/>
	<arg name="initial_pose_a" default="-1.57"/>

    <!--开启导航-->
        <!-- 启动底盘及激光雷达驱动包 -->
    <include file="$(find ucar_controller)/launch/ucar_bringup.launch" />
        <!-- 启动USB摄像头驱动包 -->
    <include file="$(find usb_cam)/launch/usb_cam.launch" />
    <!-- <include file="$(find usb_cam)/launch/usb_cam-test.launch" /> -->
        <!-- 启动Map server功能包，发布地图 -->
    <arg name="map_file" default="$(find ucar_nav)/maps/xunfei_thrid.yaml" />
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen">
        <param name="frame_id" value="map" />
    </node>
        <!-- 启动AMCL 自适应蒙特卡洛定位算法包 -->
    <include file="$(find ucar_nav)/launch/amcl_omni.launch">
        <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
        <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
        <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
    <include file="$(find ucar_nav)/launch/teb_move_base_omni_20230727.launch"/>  


    <node name="robot_pose_publisher" pkg="robot_pose_publisher" type="robot_pose_publisher"/>
    <!--node name="darren_launch" pkg="darren_launch" type="lax_controller.py" output="screen"/-->

    <!-- 开启麦克风唤醒词 -->
    <include file="$(find xf_mic_asr_offline)/launch/mic_init.launch" /> 
    <!--语音控制-->
    <include file="$(find xf_mic_asr_offline)/launch/voice_control.launch" />
    <!-- 开启语音合成-->
    <include file="$(find xf_tts_offline)/launch/xf_tts.launch" />

    <include file="$(find darknet_ros)/launch/yolov4-tiny.launch" />

    <node pkg="darren_launch" name="task_control" type="csp_task_control.py" output="screen" respawn="false" />

    <node pkg="darknet_ros" name="darknet_ros_video" type="darknet_sub" output="screen" respawn="false" />

    <!-- <node pkg="ucar_yolo" name="ucar_yolo_vegetation" type="pz_vegetation_darknet_ucar_yolo.py" output="screen" respawn="false" /> -->

    <node pkg="ucar_yolo" name="ucar_yolo_fruits" type="cpz_fruits_darknet_ucar_yolo.py" output="screen" respawn="false" />

    <!-- <node pkg="usb_cam" name="usb_cam_image" type="image_sub" output="screen" respawn="false" /> -->

    <!-- <node pkg="darren_launch" name="imu_flag" type="imu" output="screen" respawn="false" /> -->

    <!-- <node pkg="darren_launch" name="lax_aruco" type="lax_aruco.py" output="screen" respawn="false" /> -->

</launch>
