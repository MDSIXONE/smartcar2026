<launch>
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/video0" />
    
    <!-- /dev/video0 -->
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="io_method" value="mmap"/>
    <param name="framerate" value="30"/>
    
    <param name="camera_info_url" type="string" value="file://$(find ucar_cam)/camera_calibration.yaml" />
  </node>

  <node name="usb_cam_flip" pkg="ucar_cam" type="cv_bridge_flip.py" output="screen" ></node>

  <!-- <node pkg="tf" type="static_transform_publisher" name="base_link_to_cam" args="0.15 0 0.15 -2.007126944 0.0 -1.570795 base_link camera_link 20"/> -->
</launch>
