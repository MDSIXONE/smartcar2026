<launch>
  <!-- Step 2 only: run after task3_prepare.launch is already active. -->
  <!-- Either provide cargo_item (automatic category inference) or explicitly
       provide cargo_category.  Examples: cargo_item:=苹果, cargo_category:=电子产品. -->
  <arg name="cargo_item" default=""/>
  <arg name="cargo_category" default="auto"/>
  <arg name="cargo_name" default=""/>
  <!-- true selects one-pass official r_joint-triggered set_model_state
       attachment; false keeps the physical-gripper-only path. -->
  <arg name="attachment_fallback_enabled" default="true"/>

  <node name="task3_pick_deliver" pkg="car3" type="task3_pick_deliver.py" output="screen">
    <rosparam command="load" file="$(find car3)/config/task3_vision.yaml"/>
    <param name="cargo_item" value="$(arg cargo_item)"/>
    <param name="cargo_category" value="$(arg cargo_category)"/>
    <param name="cargo_name" value="$(arg cargo_name)"/>
    <param name="attachment_fallback_enabled"
           value="$(arg attachment_fallback_enabled)"/>
    <param name="vision_model_path"
           value="$(find car3)/models/vision/cube_yolov5_best.onnx"/>
    <param name="vision_label_template_dir"
           value="$(find car3)/models/cube/meshes"/>
    <param name="arm_grasp_pose" value="-0.0001,1.5000,0.2800,1.3000,0.0000"/>
    <param name="arm_carry_pose" value="-0.0001,0.0000,-1.7200,-0.5000,0.0000"/>
    <!-- Stop the descent as soon as contact starts twisting the uncommanded
         wrist, then back off to a recent stable approach sample. -->
    <param name="grasp_wrist_rotation_limit" value="0.035"/>
    <param name="grasp_guard_history_samples" value="6"/>
    <param name="grasp_guard_recovery_duration" value="0.25"/>
    <param name="wait_for_initial_arm_pose" value="false"/>
  </node>
</launch>
