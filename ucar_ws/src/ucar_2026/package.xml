  <version>0.0.0</version>
  <description>Launch and support resources for the 2026 real UCar navigation setup.</description>

  <maintainer email="ucar@todo.todo">ucar</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cym_planner</exec_depend>
  <exec_depend>jie_ware</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>robot_pose_publisher</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rostopic</exec_depend>
