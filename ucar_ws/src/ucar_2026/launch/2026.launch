<launch>
    <!-- 真机运行：use_sim_time 必须为 false。此处不再声明，
         交由 ucar_bringup.launch 设为 false（避免 ROS 时间卡在 0 导致 TF/定位停摆）。 -->

    <!--起始点（2026 warehouse 区，车头朝 +X）-->
    <arg name="initial_pose_x" default="-0.25"/>
    <arg name="initial_pose_y" default="2.75"/>
    <arg name="initial_pose_a" default="0"/>
    <!-- Disable this only when the full-task navigation_2026 node takes over
         /scan_raw forwarding and production-phase obstacle freezing. -->
    <arg name="scan_relay_enabled" default="true"/>
    <!-- Explicit opt-in.  The normal launch remains navigation-only and never
         moves the vehicle without task_enabled:=true. -->
    <arg name="task_enabled" default="false"/>
    <arg name="task_start_delay" default="2.0"/>
    <!-- No RViz/camera workload by default. Set false only when a manual
         session explicitly needs an immediately-live camera stream. -->
    <arg name="camera_start_suspended" default="true"/>
    <!-- RViz-only chassis model; it is a visual on the existing base_link and
         does not create TF, collision geometry, or a control dependency. -->
    <param name="robot_description" textfile="$(find ucar_2026)/urdf/ucar_2026_visual.urdf"/>

    <!-- The driver keeps its fixed /scan_raw output.  navigation_scan_relay
         restores /scan for localization and publishes a separately filtered
         global-obstacle stream. -->
    <group>
        <remap from="scan" to="scan_raw"/>
        <include file="$(find ucar_controller)/launch/ucar_bringup.launch"/>
    </group>

    <!-- Keep the camera node available without consuming capture bandwidth.
         The automatic task starts/stops it around QR/OCR; a manual RViz
         session may opt in with camera_start_suspended:=false. -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen"
          respawn="$(eval arg('task_enabled') != 'true')" respawn_delay="2.0">
        <param name="video_device" value="/dev/ucar_video"/>
        <param name="image_width" value="640"/>
        <param name="image_height" value="480"/>
        <param name="pixel_format" value="yuyv"/>
        <param name="camera_frame_id" value="usb_cam"/>
        <param name="io_method" value="mmap"/>
        <param name="framerate" value="30"/>
        <param name="create_suspended" value="$(arg camera_start_suspended)"/>
        <param name="camera_info_url" type="string"
               value="file://$(find ucar_cam)/camera_calibration.yaml"/>
    </node>

    <!-- A transient Python/ROS registration failure must not leave lidar_loc
         without /scan forever: retry the bridge before move_base is used. -->
    <node if="$(arg scan_relay_enabled)"
          pkg="ucar_2026" type="navigation_scan_relay.py"
          name="navigation_scan_relay" output="screen" respawn="true"
          respawn_delay="2.0"
          launch-prefix="$(find ucar_2026)/scripts/run_melodic_python2.sh">
        <param name="global_obstacle_filter_enabled" value="true"/>
        <param name="global_static_filter_radius" value="0.22"/>
        <param name="global_static_filter_threshold" value="65"/>
        <param name="global_transform_max_age" value="0.20"/>
    </node>

    <!-- Use the field-wall map without middle vertices for real navigation. -->
    <arg name="map_file" default="$(find ucar_nav)/maps/iflysse_field_walls_without_middle_vertices.yaml" />
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen">
        <param name="frame_id" value="map" />
    </node>

    <!-- The scan matcher is the sole publisher of map -> odom.  It derives
         the correction from lidar and odom at the same scan timestamp. -->
    <node pkg="jie_ware" type="lidar_loc" name="lidar_loc" output="screen" respawn="false">
        <param name="base_frame" value="base_link"/>
        <param name="odom_frame" value="odom"/>
        <param name="laser_frame" value="laser_frame"/>
        <param name="laser_topic" value="scan"/>
        <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
        <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
        <param name="initial_pose_a" value="$(arg initial_pose_a)"/>
        <param name="tf_publish_tolerance" value="0.15"/>
    </node>

    <!-- Reject isolated single-beam returns for the local obstacle layer.
         lidar_loc remains on raw /scan so scan-to-map localization keeps the
         separately verified Y-sign convention and all wall observations. -->
    <node pkg="jie_ware" type="lidar_filter_node" name="lidar_filter_node" output="screen" respawn="false">
        <param name="source_topic" value="/scan"/>
        <param name="pub_topic" value="/scan_filtered"/>
        <param name="outlier_threshold" value="0.10"/>
    </node>

    <!-- Same move_base/CymPlanner flow as the simulation.  The plugin writes
         /cmd_vel directly to the chassis driver; RViz is the only goal source. -->
    <include file="$(find ucar_nav)/launch/cym_move_base_omni_2026.launch"/>

    <node name="robot_pose_publisher" pkg="robot_pose_publisher" type="robot_pose_publisher"/>

    <group if="$(arg task_enabled)">
        <!-- ucar_2026 already owns the camera.  Keep decoding disabled until
             the mission explicitly enters its QR stage. -->
        <include file="$(find yolo2025)/launch/qrcode.launch">
            <arg name="start_camera" value="false"/>
            <arg name="scan_enabled" value="false"/>
            <arg name="api_enabled" value="false"/>
        </include>

        <node pkg="ucar_2026" type="production_task_2026.py"
              name="production_task_2026" output="screen" required="true"
              launch-prefix="$(find ucar_2026)/scripts/run_melodic_python2.sh">
            <param name="grid_path"
                   value="$(find ucar_2026)/config/production_full_grid_all_numbered.json"/>
            <param name="start_delay" value="$(arg task_start_delay)"/>
            <param name="staging_point_number" value="52"/>
            <rosparam param="qr_observation_numbers">[262, 232, 295]</rosparam>
            <!-- Each target is reached before one OCR search revolution.  A
                 candidate is centred/ranged; no candidate goes straight on. -->
            <rosparam param="production_route_numbers">[12, 23, 14, 25, 16]</rosparam>
            <rosparam param="production_observation_headings_deg">[-45, 45, -45, 45, 45]</rosparam>
            <!-- Timeout only: a fresh QR event advances immediately. -->
            <param name="qr_search_timeout" value="4.0"/>
            <param name="qr_rotation_speed" value="0.18"/>
            <param name="post_turn_recenter_trigger" value="0.06"/>
            <param name="post_turn_recenter_attempts" value="2"/>
            <param name="require_distinct_qr_codes" value="true"/>
            <!-- Before the first move_base goal, production_task_2026 pins
                 CymPlanner to front-lookahead point mode for every task leg. -->
            <param name="navigation_mode_connect_timeout" value="5.0"/>
            <param name="camera_node_name" value="/usb_cam"/>
            <param name="camera_starts_suspended"
                   value="$(arg camera_start_suspended)"/>
            <param name="camera_start_service" value="/usb_cam/start_capture"/>
            <param name="camera_stop_service" value="/usb_cam/stop_capture"/>
            <param name="camera_service_timeout" value="5.0"/>
            <param name="use_ros_camera_for_ocr" value="true"/>
            <param name="camera_image_topic" value="/usb_cam/image_raw"/>
            <param name="video_device" value="/dev/ucar_video"/>
            <param name="camera_width" value="640"/>
            <param name="camera_height" value="480"/>
            <param name="ocr_python" value="/usr/bin/python3"/>
            <param name="ocr_helper_path"
                   value="$(find ucar_2026)/scripts/production_camera_ocr.py"/>
            <param name="live_ppocr_path"
                   value="/home/ucar/ocr3/ppocr_trt/python/live_ppocr.py"/>
            <param name="ppocr_root" value="/home/ucar/ocr3/ppocr_trt"/>
            <param name="ocr_side" value="640"/>
            <param name="camera_mirror" value="true"/>
            <param name="ocr_min_confidence" value="0.30"/>
            <param name="ocr_scan_rotation_speed" value="0.18"/>
            <param name="ocr_scan_poll_period" value="0.20"/>
            <param name="ocr_scan_candidate_confidence" value="60.0"/>
            <param name="goal_cancel_timeout" value="3.0"/>
            <param name="stop_confirmation_timeout" value="2.0"/>
            <param name="stopped_odom_speed_epsilon" value="0.02"/>
            <param name="stopped_odom_samples" value="3"/>
            <param name="ocr_alignment_tolerance_px" value="18.0"/>
            <param name="ocr_alignment_max_speed" value="0.22"/>
            <param name="front_scan_half_angle_deg" value="3.0"/>
            <param name="lidar_forward_offset_m" value="0.0"/>
            <param name="wall_match_max_error_m" value="0.18"/>
            <!-- Dynamic-only pre-arrival guard.  The scan is the same source
                 used by the global obstacle layer, with static walls masked. -->
            <param name="target_guard_scan_topic" value="/scan_global_obstacles"/>
            <param name="target_guard_match_radius_m" value="0.12"/>
            <param name="target_guard_confirmation_scans" value="2"/>
            <param name="target_guard_precheck_timeout" value="0.50"/>
            <param name="target_guard_scan_max_age" value="0.50"/>
            <param name="result_directory"
                   value="$(env HOME)/.ros/ucar_2026_observations"/>
        </node>
    </group>
</launch>
