    task.report_result("小车启动完成，等待唤醒")
    #task.report_result("我有20元")
    while True: 
        if not task.get_task_start_flag():
            rospy.sleep(0.1)
            if skip_voice==0:
                continue
        if rospy.is_shutdown():
            exit()

        while True:#index < points_num:
            index=index+1
            pose = list(waypoints_dict.values())[index]#switch(points_list[index])
            point_name=list(waypoints_dict.keys())[index]
            goal=goal_pose(pose)
            done=0
            starttime=time.time()
            client.send_goal(goal,done_cb=done_cb)
            rospy.sleep(0.1)#丢点可能是因为这里！ 休眠20ms ，否则貌似wait_for_result会直接使用上一次的结果（已经到位）导致跳过某个点
            print("waiting for point no."+str(index))
            print(point_name)
            while done==0:
                rospy.sleep(0.1)
            
            client.wait_for_result()  # <180 RIGHT
            
            print("耗时"+str(time.time()-starttime))
            print("got there!"+str(index))
            if(time.time()-starttime<0.65):
                print("lost")
                index=index-1
                continue
            if point_name=="point1":
                pass
                #task.qrcode_start_pub.publish(1)#提前启动二维码    
            if point_name=="point2":
                # 
