<launch>
    <param name="use_sim_time" value="false"/>

    <!-- 启动ucar_driver驱动-->
    <node pkg="ucar_controller" name="base_driver" type="base_driver" output="screen">
        <rosparam command="load" file="$(find ucar_controller)/config/driver_params_mini.yaml" />
        <remap from="/odom" to="/odom_raw"/>
        
        <!--remap from="/cmd_vel" to= "/smooth_cmd_vel" /-->

        <param name="provide_odom_tf" value="false"/>
    </node>
    
    <!-- 启动EKF融合定位节点 -->
    <node pkg="robot_pose_ekf" type="robot_pose_ekf" name="robot_pose_ekf" output="screen">
        <param name="output_frame" value="odom"/>
        <param name="base_footprint_frame" value="base_link"/>
        <param name="freq" value="30.0"/>
        <!-- The chassis odom/imu briefly goes silent for ~1.0-1.04 s on every run
             (MCU/serial characteristic). 1.0 s made robot_pose_ekf declare the
             sensor dead and print "Odom sensor not active any more", which the
             task treats as fatal; 3.0 s tolerates the normal gap while still
             detecting a real sensor loss. -->
        <param name="sensor_timeout" value="3.0"/>
        <param name="odom_used" value="true"/>
        <param name="imu_used"  value="true"/>
        <param name="vo_used"   value="false"/>
        <remap from="odom" to="/odom_raw"/>
        <remap from="/imu_data" to="/imu"/>
        <remap from="/robot_pose_ekf/odom_combined" to="/odom_combined"/>
    </node>
    
    <node pkg="ucar_controller" type="lax_odom_ekf.py" name="lax_odom_ekf_node" output="screen">
        <remap from="input" to="/odom_combined"/>
        <remap from="output" to="/odom"/>
    </node>

    <!-- 启动激光雷达驱动包  -->
    <include file="$(find ydlidar)/launch/ydlidar.launch" />

    <!--node  name="robot_state_publisher"  pkg="robot_state_publisher" type="robot_state_publisher" /-->

    <!--include file="$(find ucar_controller)/launch/tf_server.launch" /-->

    <node pkg="tf" type="static_transform_publisher" name="base_link_to_imu" args="0.05 -0.05 0.05 0 0 0 /base_link /imu 40"/>
    <!-- The lidar is mounted parallel to base_link.  A previous -0.07 rad
         yaw rotated every RViz scan clockwise by about four degrees. -->
    <node pkg="tf" type="static_transform_publisher" name="base_link_to_laser" args="-0.11 0.0 0.165 0.0 0.0 0.0 /base_link /laser_frame 40" />
    <node pkg="tf" type="static_transform_publisher" name="base_link_to_camera" args="0.15 0.0 0.15 -1.570795 0.0  -2.007126944 /base_link /camera_link 40" />

</launch>
