<launch>
    <param name="use_sim_time" value="true"/>
    <!--yolo、nyolo、fyolo-->
    <arg name="yolov3" default="$(optenv YOLOV3 yolo)"/>
    <!--起始点-->
    <arg name="initial_pose_x" default="0.0"/>
	<arg name="initial_pose_y" default="0.0"/>
	<arg name="initial_pose_a" default="0.0"/>

    <!--开启导航-->
        <!-- 启动底盘及激光雷达驱动包 -->
    <include file="$(find ucar_controller)/launch/ucar_bringup.launch" />
        <!-- 启动USB摄像头驱动包 -->
    <include file="$(find ucar_cam)/launch/ucar_cam.launch" />
        <!-- 启动Map server功能包，发布地图 -->
    <arg name="map_file" default="$(find ucar_map)/maps/lax_map4.yaml" />
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen">
        <param name="frame_id" value="map" />
    </node>
        <!-- 启动AMCL 自适应蒙特卡洛定位算法包 -->
    <include file="$(find ucar_nav)/launch/amcl_omni.launch">
        <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
        <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
        <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
    <group if="$(eval arg('yolov3') == 'nyolo')">
        <include file="$(find ucar_nav)/launch/teb_move_base_omni.launch"/>
    </group>
    <group if="$(eval arg('yolov3') == 'fyolo')">
        <include file="$(find ucar_nav)/launch/teb_move_base_omni_fast.launch"/>
    </group>   
    <group if="$(eval arg('yolov3') == 'yolo')">
        <include file="$(find ucar_nav)/launch/teb_move_base_omni_yolo_test.launch"/>    
    </group>
    <node name="robot_pose_publisher" pkg="robot_pose_publisher" type="robot_pose_publisher"/>
    <node name="lax_controller" pkg="lax_controller" type="lax_controller.py" output="screen"/>

    <!--开启yolo-->
    <group if="$(eval arg('yolov3') == 'yolo')">
        <include file="$(find ucar_cam)/launch/lax_yolo.launch" />
    </group>
    

    <!--开启麦克风唤醒词-->
    <include file="$(find xf_mic_asr_offline)/launch/mic_init.launch" />
    <!--语音控制-->
    <include file="$(find xf_mic_asr_offline)/launch/voice_control.launch" />
    <!--开启语音合成-->
    <include file="$(find xf_tts_offline)/launch/xf_tts.launch" />



    <node pkg="lax_controller" name="lax_aruco" type="lax_aruco.py" output="screen" respawn="false" />

    <!-- include file="$(find yocs_velocity_smoother)/launch/test_translational_smoothing.launch" /-->
</launch>
